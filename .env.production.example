# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Application Configuration
NODE_ENV=production
PORT=5000
APP_NAME=SmartNotes
APP_VERSION=2.0.0
APP_URL=https://smartnotes.app
CLIENT_URL=https://app.smartnotes.app
API_URL=https://api.smartnotes.app

# Database Configuration (Use managed database service)
DATABASE_URL=mysql://username:password@db-host:3306/smartnotes_prod
DB_HOST=your-managed-db-host.com
DB_PORT=3306
DB_USER=smartnotes_user
DB_PASSWORD=your-secure-db-password
DB_NAME=smartnotes_production
DB_SSL=true
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_TIMEOUT=60000

# Redis Configuration (For caching and sessions)
REDIS_URL=redis://username:password@redis-host:6379
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_TLS=true

# Security Configuration
SESSION_SECRET=your-super-secure-session-secret-min-32-chars
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
CSRF_SECRET=your-csrf-secret-key-min-32-chars
COOKIE_SECRET=your-cookie-secret-min-32-chars
ENCRYPTION_KEY=your-32-byte-encryption-key-for-sensitive-data
BCRYPT_ROUNDS=12

# API Keys and External Services
OPENAI_API_KEY=your-openai-api-key
MISTRAL_API_KEY=your-mistral-api-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Email Service (SendGrid, AWS SES, etc.)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@smartnotes.app
EMAIL_FROM_NAME=SmartNotes
SUPPORT_EMAIL=support@smartnotes.app

# File Storage (AWS S3, Google Cloud Storage, etc.)
STORAGE_SERVICE=s3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=smartnotes-production-files
AWS_CLOUDFRONT_DOMAIN=cdn.smartnotes.app

# Monitoring and Logging
LOG_LEVEL=info
LOG_MAX_FILES=10
LOG_MAX_SIZE=20971520
SENTRY_DSN=your-sentry-dsn-for-error-tracking
DATADOG_API_KEY=your-datadog-api-key
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_MAX=100

# Performance Configuration
CACHE_TTL=3600
API_TIMEOUT=30000
COMPRESSION_THRESHOLD=1024
COMPRESSION_LEVEL=6
MAX_REQUEST_SIZE=50mb
HEADERS_TIMEOUT=66000
KEEP_ALIVE_TIMEOUT=65000

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/smartnotes.crt
SSL_KEY_PATH=/etc/ssl/private/smartnotes.key
FORCE_HTTPS=true

# CORS Configuration
CORS_ORIGIN=https://smartnotes.app,https://app.smartnotes.app
CORS_CREDENTIALS=true

# Feature Flags
FEATURE_AI_ASSISTANT=true
FEATURE_COLLABORATION=true
FEATURE_ANALYTICS=true
FEATURE_BILLING=true
FEATURE_ADMIN_PANEL=true

# Subscription Limits
FREE_TIER_NOTES_LIMIT=50
FREE_TIER_STORAGE_LIMIT=100MB
PRO_TIER_NOTES_LIMIT=1000
PRO_TIER_STORAGE_LIMIT=5GB
TEAM_TIER_NOTES_LIMIT=10000
TEAM_TIER_STORAGE_LIMIT=50GB

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token
HOTJAR_ID=your-hotjar-id

# Legal and Compliance
PRIVACY_POLICY_URL=https://smartnotes.app/privacy
TERMS_OF_SERVICE_URL=https://smartnotes.app/terms
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=2555

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=smartnotes-backups

# Multi-tenancy
MULTI_TENANT_MODE=subdomain
DEFAULT_TENANT=app
TENANT_ISOLATION=strict

# Security Headers
HSTS_MAX_AGE=31536000
CSP_REPORT_URI=https://smartnotes.report-uri.com/r/d/csp/enforce

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-for-external-integrations
WEBHOOK_TIMEOUT=10000

# Development/Staging Overrides (remove in production)
# DEBUG=false
# MOCK_PAYMENTS=false
# SKIP_EMAIL_VERIFICATION=false

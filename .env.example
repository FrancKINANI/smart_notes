# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=smart_notes
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Session et sécurité
SESSION_SECRET=your-session-secret
JWT_SECRET=your-jwt-secret-key
CSRF_SECRET=your-csrf-secret-key
COOKIE_SECRET=your-cookie-secret
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LLM — Sélection du provider (server/services/llm-provider.ts)
# -----------------------------------------------------------------------------
# Deux modes de sélection, par ordre de priorité :
#   1) CONFIG EN BASE (recommandé, bascule à chaud sans redémarrage) :
#      l'administrateur choisit le provider via la page /admin
#      (routes GET/PUT /api/admin/llm-settings, table llm_settings).
#   2) VARIABLE D'ENVIRONNEMENT ci-dessous : utilisée UNIQUEMENT comme fallback
#      si aucune config n'est enregistrée en base (compat rétroactive).
#
# Les clés API cloud restent TOUJOURS en variables d'environnement (jamais en
# base de données). Valeurs possibles de LLM_PROVIDER :
#   openrouter (défaut) | openai | grok | deepseek | openai-compatible | qvac
LLM_PROVIDER=openrouter

# --- Presets cloud (selon LLM_PROVIDER choisi) ---
# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (accès à des centaines de modèles via une seule clé)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Grok (xAI)
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# --- Provider OpenAI-compatible générique (LLM_PROVIDER=openai-compatible) ---
# Ex: Ollama (http://localhost:11434/v1), LM Studio, vLLM, llama.cpp server…
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- QVAC (inférence locale, LLM_PROVIDER=qvac) ---
# Modèle : constante du registry QVAC (LLAMA_3_2_1B_INST_Q4_0 | QWEN3_600M_INST_Q4 | QWEN3_1_7B_INST_Q4)
#          ou URL http(s) / chemin local vers un fichier .gguf.
# Téléchargé en P2P au premier démarrage dans ~/.qvac/models (~1-5 Go). Ne jamais committer ce cache.
QVAC_MODEL_SRC=LLAMA_3_2_1B_INST_Q4_0

# -----------------------------------------------------------------------------
# Benchmark LLM (scripts/benchmark-llm-providers.ts) — prix par million de tokens
# -----------------------------------------------------------------------------
LLM_INPUT_PRICE_PER_MTOK=0.5
LLM_OUTPUT_PRICE_PER_MTOK=1.5

# Configuration de l'environnement
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Cache et performances
CACHE_TTL=300
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
API_TIMEOUT=30000
COMPRESSION_THRESHOLD=2048
COMPRESSION_LEVEL=6
LOG_LEVEL=info
LOG_MAX_FILES=5
LOG_MAX_SIZE=10485760

# Sécurité
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=900
SESSION_TIMEOUT=86400
SECURE_COOKIES=false # Mettre à true en production

# Monitoring et performances
ENABLE_MONITORING=true
METRICS_INTERVAL=60000
MAX_REQUEST_SIZE=10485760
KEEP_ALIVE_TIMEOUT=65000
HEADERS_TIMEOUT=66000
REQUEST_TIMEOUT=30000

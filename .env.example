# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=smart_notes
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Session and security
SESSION_SECRET=your-session-secret
JWT_SECRET=your-jwt-secret-key
CSRF_SECRET=your-csrf-secret-key
COOKIE_SECRET=your-cookie-secret
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LLM — Provider selection (server/services/llm-provider.ts)
# -----------------------------------------------------------------------------
# Two selection modes, by priority order:
#   1) DATABASE CONFIG (recommended, hot switch without restart):
#      the administrator chooses the provider via the /admin page
#      (GET/PUT /api/admin/llm-settings routes, llm_settings table).
#   2) ENVIRONMENT VARIABLE below: used ONLY as a fallback
#      if no config is saved in the database (backward compatibility).
#
# Cloud API keys ALWAYS stay in environment variables (never in the
# database). Possible values for LLM_PROVIDER:
#   openrouter (default) | openai | grok | deepseek | openai-compatible | qvac
LLM_PROVIDER=openrouter

# --- Cloud presets (depending on the chosen LLM_PROVIDER) ---
# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (access to hundreds of models via a single key)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Grok (xAI)
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# --- Generic OpenAI-compatible provider (LLM_PROVIDER=openai-compatible) ---
# E.g., Ollama (http://localhost:11434/v1), LM Studio, vLLM, llama.cpp server…
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- QVAC (local inference, LLM_PROVIDER=qvac) ---
# Model: QVAC registry constant (LLAMA_3_2_1B_INST_Q4_0 | QWEN3_600M_INST_Q4 | QWEN3_1_7B_INST_Q4)
#         or http(s) URL / local path to a .gguf file.
# Downloaded via P2P on first start into ~/.qvac/models (~1-5 GB). Never commit this cache.
QVAC_MODEL_SRC=LLAMA_3_2_1B_INST_Q4_0

# -----------------------------------------------------------------------------
# LLM Benchmark (scripts/benchmark-llm-providers.ts) — price per million tokens
# -----------------------------------------------------------------------------
LLM_INPUT_PRICE_PER_MTOK=0.5
LLM_OUTPUT_PRICE_PER_MTOK=1.5

# Environment configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Cache and performance
CACHE_TTL=300
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
API_TIMEOUT=30000
COMPRESSION_THRESHOLD=2048
COMPRESSION_LEVEL=6
LOG_LEVEL=info
LOG_MAX_FILES=5
LOG_MAX_SIZE=10485760

# Security
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=900
SESSION_TIMEOUT=86400
SECURE_COOKIES=false # Set to true in production

# Monitoring and performance
ENABLE_MONITORING=true
METRICS_INTERVAL=60000
MAX_REQUEST_SIZE=10485760
KEEP_ALIVE_TIMEOUT=65000
HEADERS_TIMEOUT=66000
REQUEST_TIMEOUT=30000
